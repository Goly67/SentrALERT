# Firebase Realtime Database — the free Spark plan, no Firestore involved.
# Copy this file to .env.local and fill in values from
# Firebase Console -> Project settings -> General -> Your apps -> SDK config.
# Leave any of these blank and the app runs on in-memory sample data instead.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional NASA FIRMS key for fresher national satellite fire detections.
# Get one from https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_FIRMS_MAP_KEY= b80fb8ac0ac5fc4f30a2d668686dcc39
